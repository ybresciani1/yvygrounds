{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "yvygrounds",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "yvygrounds-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8082"],
      "port": 8082
    },
    {
      "name": "yvygrounds-3",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8093"],
      "port": 8093,
      "autoPort": false
    },
    {
      "name": "society-api-local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["society-api/node_modules/wrangler/bin/wrangler.js", "dev", "--config", "society-api/wrangler.jsonc",
        "--persist-to", "society-api/.wrangler/state", "--port", "8787", "--var", "ALLOWED_ORIGINS:http://localhost:8093"],
      "port": 8787,
      "autoPort": false
    }
  ]
}
