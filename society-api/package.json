{
  "name": "yvygrounds-society-api",
  "private": true,
  "description": "Cloudflare Worker for the YvyGrounds Garden Society: submissions, approvals, projects and the compost log.",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "migrate:local": "wrangler d1 migrations apply yvygrounds-society --local",
    "migrate:remote": "wrangler d1 migrations apply yvygrounds-society --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
